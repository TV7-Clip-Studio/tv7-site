---
import GlowPanel from './GlowPanel.astro';

interface Props {
  headline: string;
  subheadline: string;
  primaryLabel: string;
  secondaryLabel: string;
}

const { headline, subheadline, primaryLabel, secondaryLabel } = Astro.props as Props;
---

<section class="relative overflow-hidden rounded-3xl border border-tv7-border bg-gradient-to-br from-tv7-bg via-tv7-bgSecondary to-tv7-surface px-6 py-12 sm:px-10 sm:py-16 shadow-lg">
  <div class="absolute inset-0 hero-backdrop opacity-30"></div>
  <div class="relative grid gap-10 lg:grid-cols-2 lg:items-center">
    <div class="space-y-6">
      <div class="inline-flex items-center gap-2 rounded-full border border-tv7-amber/30 bg-tv7-amber/10 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-tv7-amber">
        Clips at the speed of thought
      </div>
      <h1 class="text-4xl sm:text-5xl lg:text-6xl font-display font-semibold tracking-tight text-tv7-text-primary leading-tight">
        {headline}
      </h1>
      <p class="text-lg text-tv7-text-secondary max-w-xl">{subheadline}</p>
      <div class="flex flex-col sm:flex-row gap-4">
        <a
          href="/downloads"
          class="btn-primary"
        >
          {primaryLabel}
        </a>
        <a
          href="/how-it-works"
          class="inline-flex items-center justify-center gap-2 rounded-full border border-tv7-border px-5 py-3 text-base font-semibold text-tv7-text-primary hover:border-tv7-cyan/50 hover:text-tv7-cyan transition"
        >
          {secondaryLabel}
        </a>
      </div>
      <div class="grid grid-cols-2 gap-4 max-w-lg">
        <div class="rounded-xl border-l-2 border-l-tv7-amber border-t border-r border-b border-tv7-border bg-tv7-surface/60 px-4 py-3">
          <p class="text-xs uppercase tracking-wider text-tv7-text-tertiary mb-1">Local-first</p>
          <p class="text-tv7-text-primary font-semibold">Edge AI, no uploads</p>
        </div>
        <div class="rounded-xl border-l-2 border-l-tv7-amber border-t border-r border-b border-tv7-border bg-tv7-surface/60 px-4 py-3">
          <p class="text-xs uppercase tracking-wider text-tv7-text-tertiary mb-1">Creators & teams</p>
          <p class="text-tv7-text-primary font-semibold">Clips ready in minutes</p>
        </div>
      </div>
    </div>
    <div class="relative">
      <GlowPanel class="relative z-10 p-6 bg-gradient-to-br from-tv7-surface via-tv7-bgSecondary to-tv7-surface">
        <div class="flex items-center justify-between mb-4">
          <div>
            <p class="text-xs uppercase tracking-wider text-tv7-text-tertiary">Session</p>
            <p class="text-tv7-text-primary font-semibold">Reel: Product Launch</p>
          </div>
          <span class="rounded-full bg-tv7-amber/15 px-3 py-1 text-xs font-semibold text-tv7-amber border border-tv7-amber/30">
            Live
          </span>
        </div>
        <div class="aspect-[4/3] w-full overflow-hidden rounded-xl border-2 border-tv7-borderStrong bg-tv7-bg shadow-inner relative">
          <!-- Frame corners (video editor aesthetic) -->
          <div class="absolute top-1 left-1 w-4 h-4 border-t-2 border-l-2 border-tv7-amber/50"></div>
          <div class="absolute top-1 right-1 w-4 h-4 border-t-2 border-r-2 border-tv7-amber/50"></div>
          <div class="absolute bottom-1 left-1 w-4 h-4 border-b-2 border-l-2 border-tv7-amber/50"></div>
          <div class="absolute bottom-1 right-1 w-4 h-4 border-b-2 border-r-2 border-tv7-amber/50"></div>
          <div class="h-full w-full bg-gradient-to-br from-tv7-surface/40 via-tv7-bg to-tv7-bgSecondary/40"></div>
        </div>
        <!-- Timeline with cyan playhead -->
        <div class="mt-3 h-1 bg-tv7-border rounded-full overflow-hidden relative">
          <div class="absolute left-0 top-0 h-full w-1/3 bg-gradient-to-r from-tv7-cyan/60 to-tv7-cyan"></div>
          <div class="absolute left-1/3 top-0 h-full w-1 bg-tv7-cyan shadow-[0_0_8px_rgba(0,229,255,0.6)]"></div>
        </div>
        <div class="mt-4 grid grid-cols-3 gap-3 text-xs">
          {['Clipping', 'Captions', 'Social'].map((chip) => (
            <div class="rounded-lg border border-tv7-border bg-tv7-bg/60 px-3 py-2 text-tv7-text-secondary flex items-center gap-2">
              <span class="inline-block h-2 w-2 rounded-full bg-tv7-amber"></span>
              {chip}
            </div>
          ))}
        </div>
        <div class="mt-5 flex items-center justify-between rounded-lg border border-tv7-borderStrong bg-tv7-bg/60 px-4 py-3">
          <div>
            <p class="text-xs uppercase tracking-wider text-tv7-text-tertiary">AI highlight found</p>
            <p class="text-tv7-text-primary font-semibold">00:12:44 → 00:13:58</p>
          </div>
          <button class="rounded-full bg-tv7-cyan px-3 py-2 text-xs font-semibold text-slate-900 shadow-accent-subtle hover:shadow-accent-hover hover:bg-tv7-cyanSoft transition">
            Export clip
          </button>
        </div>
      </GlowPanel>
    </div>
  </div>
</section>
