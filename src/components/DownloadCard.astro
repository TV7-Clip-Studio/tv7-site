---
import GlowPanel from './GlowPanel.astro';

interface Props {
  os: string;
  description: string;
  action?: string;
  badge?: string;
}

const { os, description, action = 'Download', badge } = Astro.props as Props;
---

<GlowPanel class="p-6 flex h-full flex-col gap-4 transition hover:border-tv7-cyan/60 hover:shadow-cyan-strong">
  <div class="flex items-center justify-between">
    <div class="text-lg font-display font-semibold text-tv7-text-primary">{os}</div>
    {badge && (
      <span class="rounded-full bg-tv7-cyan/15 px-3 py-1 text-xs font-semibold text-tv7-cyan border border-tv7-cyan/30">
        {badge}
      </span>
    )}
  </div>
  <p class="text-sm text-tv7-text-secondary">{description}</p>
  <button class="btn-primary w-full px-4 py-2 text-sm">
    {action}
  </button>
</GlowPanel>
