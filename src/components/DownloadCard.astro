---
interface Props {
  os: string;
  description: string;
  action?: string;
  badge?: string;
}

const { os, description, action = 'Download', badge } = Astro.props as Props;
---

<div class="glow-panel p-6 flex flex-col gap-4 hover:border-tv7-cyan/60 hover:shadow-cyan-strong transition">
  <div class="flex items-center justify-between">
    <div class="text-lg font-semibold text-slate-100">{os}</div>
    {badge && (
      <span class="rounded-full bg-tv7-cyan/15 px-3 py-1 text-xs font-semibold text-tv7-cyan border border-tv7-cyan/30">
        {badge}
      </span>
    )}
  </div>
  <p class="text-sm text-slate-300">{description}</p>
  <button class="inline-flex items-center justify-center gap-2 rounded-full bg-tv7-cyan px-4 py-2 text-sm font-semibold text-slate-900 shadow-cyan-strong transition hover:-translate-y-[1px]">
    {action}
  </button>
</div>
