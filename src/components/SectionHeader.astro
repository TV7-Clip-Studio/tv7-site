---
interface Props {
  eyebrow?: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props as Props;
---

<div class={`mb-10 ${align === 'center' ? 'text-center' : 'text-left'}`}>
  {eyebrow && (
    <p class="text-xs font-semibold uppercase tracking-wider text-tv7-amber mb-2">{eyebrow}</p>
  )}
  <div class="inline-flex items-center gap-3">
    <h2 class="text-3xl sm:text-4xl font-display font-semibold tracking-tight text-tv7-text-primary">
      {title}
    </h2>
    <span class="h-0.5 w-16 bg-gradient-to-r from-tv7-amber to-tv7-cyan hidden sm:inline"></span>
  </div>
  {description && <p class={`mt-4 text-tv7-text-secondary ${align === 'center' ? 'mx-auto max-w-3xl' : 'max-w-2xl'}`}>{description}</p>}
</div>
