---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FAQItem from '../components/FAQItem.astro';
import GlowPanel from '../components/GlowPanel.astro';

const featureHighlights = [
  { title: 'Auto-Clipping', description: 'Drop a long video and let TV7 surface highlight-worthy beats instantly.' },
  { title: 'Smart Highlights', description: 'AI detects reactions, peaks, and quotable lines for faster storytelling.' },
  { title: 'Subtitles & Transcripts', description: 'Accurate captions with on-brand templates ready for every export.' },
  { title: 'Integrated Posts Editor', description: 'Fine-tune captions, adjust aspect ratios, and customize every clip before export—all in one workspace.' },
  { title: 'Social-Ready Exports', description: 'Landscape, square, and vertical renders optimized for every platform.' },
];

const miniFaq = [
  { question: 'Is TV7 local-first?', answer: 'Yes. Clipping and transcripts process locally so your footage stays private.' },
  { question: 'Do I need constant internet?', answer: 'No. Downloads and updates need it, but clipping and editing run offline.' },
  { question: 'Which platforms are supported?', answer: 'macOS and Windows today. Linux support is on the roadmap.' },
];
---

<BaseLayout title="TV7 — Clip Studio" description="AI-powered video clipping and repurposing desktop app.">
  <Hero
    headline="Clips at the speed of thought."
    subheadline="TV7 is the local-first desktop studio that turns YouTube videos and long recordings into social-ready clips in minutes—with full editing control."
    primaryLabel="Download for Desktop"
    secondaryLabel="Watch Demo"
  />

  <SectionWrapper id="features">
    <SectionHeader
      eyebrow="Highlights"
      title="What makes TV7 different"
      description="Designed for creators, podcasters, and teams that need studio-grade clips without the studio complexity."
    />
    <div class="grid gap-6 sm:grid-cols-2">
      {featureHighlights.map((feature) => (
        <FeatureCard title={feature.title} description={feature.description} />
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="how-it-works">
    <SectionHeader
      eyebrow="Pipeline"
      title="How it works"
      description="Five streamlined steps from YouTube link to published clips."
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { step: '01', title: 'Import your content', text: 'Paste a YouTube link or drop MP4/MOV files from your drive.' },
        { step: '02', title: 'Automatic transcription', text: 'AI generates accurate subtitles and full transcripts instantly.' },
        { step: '03', title: 'AI finds highlights', text: 'Detects momentum shifts, speakers, and quotable segments.' },
        { step: '04', title: 'Edit social posts', text: 'Customize captions, formats, and copy in the integrated posts editor.' },
        { step: '05', title: 'Export shorts', text: 'Send vertical cuts with captions straight to your social queue.' },
      ].map((item, index) => (
        <div class="relative">
          {index < 4 && <span class="absolute right-[-24px] top-6 hidden h-[2px] w-12 bg-gradient-to-r from-tv7-amber to-tv7-cyan lg:inline" />}
          <GlowPanel class="p-6 h-full border-l-2 border-l-tv7-amber">
            <div class="mb-3 flex items-center gap-2">
              <span class="rounded-full bg-tv7-amber/15 px-3 py-1 text-xs font-semibold text-tv7-amber border border-tv7-amber/30">
                {item.step}
              </span>
              <p class="text-sm uppercase tracking-wider text-tv7-text-tertiary">Step</p>
            </div>
            <h3 class="text-xl font-semibold text-tv7-text-primary mb-2">{item.title}</h3>
            <p class="text-sm text-tv7-text-secondary">{item.text}</p>
          </GlowPanel>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="use-cases">
    <SectionHeader
      eyebrow="Use Cases"
      title="Built for creators and agencies"
      description="TV7 adapts to solo workflows and scaled production pipelines."
    />
    <div class="grid gap-6 md:grid-cols-2">
      {[
        {
          title: 'Solo Creator',
          bullets: ['AI selects the best 30s–60s hooks', 'Brand-safe captions and overlays', 'No upload lag or privacy worries'],
        },
        {
          title: 'Agency / Studio',
          bullets: ['Batch process client libraries overnight', 'Shared templates and presets for teams', 'Deliverable-ready exports with logs'],
        },
      ].map((useCase) => (
        <GlowPanel class="p-6 border-l-2 border-l-tv7-amber">
          <h3 class="text-xl font-semibold text-tv7-text-primary mb-3">{useCase.title}</h3>
          <ul class="space-y-3 text-tv7-text-secondary text-sm">
            {useCase.bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-block h-2 w-2 rounded-full bg-tv7-amber"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </GlowPanel>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="faq" spacing="tight">
    <SectionHeader eyebrow="FAQ" title="Quick answers" description="Everything you need to know before you clip." />
    <div class="grid gap-4 md:grid-cols-2">
      {miniFaq.map((item, idx) => (
        <FAQItem question={item.question} answer={item.answer} open={idx === 0} />
      ))}
    </div>
    <div class="mt-6">
      <a href="/faq" class="inline-flex items-center gap-2 text-tv7-cyan hover:text-tv7-cyanSoft transition font-semibold">
        View all FAQs →
      </a>
    </div>
  </SectionWrapper>

  <SectionWrapper spacing="tight">
    <div class="relative overflow-hidden rounded-2xl border-2 border-tv7-borderStrong bg-gradient-to-r from-tv7-surface/80 via-tv7-bgSecondary/80 to-tv7-surface/80 px-6 py-10 shadow-xl">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(245,158,11,0.08),transparent_40%)] opacity-60"></div>
      <div class="relative flex flex-col items-center gap-4 text-center">
        <h3 class="text-2xl sm:text-3xl font-display tracking-tight text-tv7-text-primary">Ready to repurpose faster?</h3>
        <p class="max-w-2xl text-tv7-text-secondary">
          Join early access to get desktop builds, templates, and the latest clipping models.
        </p>
        <a
          href="/downloads"
          class="inline-flex items-center justify-center rounded-full bg-tv7-cyan px-6 py-3 text-base font-semibold text-slate-900 shadow-accent-subtle hover:shadow-accent-hover transition hover:-translate-y-[1px] hover:bg-tv7-cyanSoft"
        >
          Get Early Access
        </a>
      </div>
    </div>
  </SectionWrapper>
</BaseLayout>
