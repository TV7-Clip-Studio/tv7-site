---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import FAQItem from '../components/FAQItem.astro';
import GlowPanel from '../components/GlowPanel.astro';

const featureHighlights = [
  { title: 'Local video import', description: 'The current proof imports creator-supplied video files into a local media engine.' },
  { title: 'Channel discovery', description: 'Preview a channel list and explicitly select videos before any download attempt.' },
  { title: 'Transcript-guided selection', description: 'Import a WebVTT file, review timing candidates, and adjust a clip range.' },
  { title: 'Local captioned render', description: 'Burn imported captions into an MP4 on your computer.' },
  { title: 'Optional cloud handoff', description: 'Choose to store a finished clip privately and create a schedule draft. Publishing is still in development.' },
];

const miniFaq = [
  { question: 'Is TV7 local-first?', answer: 'Yes. The development proof renders clips locally. Uploading a finished clip for scheduling is an explicit step.' },
  { question: 'Is it available to download?', answer: 'No public release yet. A macOS development proof exists; packaging and Windows validation remain.' },
  { question: 'Can it publish posts?', answer: 'Not yet. The current workflow creates a schedule draft, not a published post.' },
];
---

<BaseLayout title="TV7 — Clip Studio" description="TV7 is a local-first creator studio in development. See the current proof and planned workflow.">
  <Hero
    headline="Clips at the speed of thought."
    subheadline="A local-first creator studio in development. The macOS proof imports video, lets you review a transcript-based clip range, and renders captions locally. Publishing and public downloads are still ahead."
    primaryLabel="See development status"
    secondaryLabel="How it works"
  />

  <SectionWrapper id="features">
    <SectionHeader
      eyebrow="Highlights"
      title="What makes TV7 different"
      description="What the internal development proof can do today."
    />
    <div class="grid gap-6 sm:grid-cols-2">
      {featureHighlights.map((feature) => (
        <FeatureCard title={feature.title} description={feature.description} />
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="how-it-works">
    <SectionHeader
      eyebrow="Pipeline"
      title="How it works"
      description="The current workflow and the next steps toward an end-to-end creator product."
    />
    <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
      {[
        { step: '01', title: 'Import a local video', text: 'Choose a creator-supplied video file. Channel discovery is available for preselection; reliable downloads are still being evaluated.' },
        { step: '02', title: 'Bring captions', text: 'Import a WebVTT transcript. Automatic transcription is planned.' },
        { step: '03', title: 'Review a candidate', text: 'Inspect transcript-based timing ranges and adjust the start and end. AI quality ranking is planned.' },
        { step: '04', title: 'Render locally', text: 'Burn the supplied captions into an MP4 with the local Rust Engine.' },
        { step: '05', title: 'Approve cloud handoff', text: 'Optionally upload the finished clip privately and create a schedule draft. Live publishing is not active.' },
      ].map((item, index) => (
        <div class="relative">
          {index < 4 && <span class="absolute right-[-24px] top-6 hidden h-[2px] w-12 bg-gradient-to-r from-tv7-amber to-tv7-cyan lg:inline" />}
          <GlowPanel class="p-6 h-full border-l-2 border-l-tv7-amber">
            <div class="mb-3 flex items-center gap-2">
              <span class="rounded-full bg-tv7-amber/15 px-3 py-1 text-xs font-semibold text-tv7-amber border border-tv7-amber/30">
                {item.step}
              </span>
              <p class="text-sm uppercase tracking-wider text-tv7-text-tertiary">Step</p>
            </div>
            <h3 class="mb-2 text-xl font-display font-semibold text-tv7-text-primary">{item.title}</h3>
            <p class="text-sm text-tv7-text-secondary">{item.text}</p>
          </GlowPanel>
        </div>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="use-cases">
    <SectionHeader
      eyebrow="Use Cases"
      title="Built for creators and agencies"
      description="The product direction, with current proof and planned work kept distinct."
    />
    <div class="grid gap-6 md:grid-cols-2">
      {[
        {
          title: 'Solo Creator',
          bullets: ['Import footage you own', 'Review a transcript-based clip range', 'Render captions on your computer'],
        },
        {
          title: 'Agency / Studio',
          bullets: ['Channel preselection is in the proof', 'Batch ingestion and durable editing are planned', 'Team tools and platform publishing remain future work'],
        },
      ].map((useCase) => (
        <GlowPanel class="p-6 border-l-2 border-l-tv7-amber">
          <h3 class="mb-3 text-xl font-display font-semibold text-tv7-text-primary">{useCase.title}</h3>
          <ul class="space-y-3 text-tv7-text-secondary text-sm">
            {useCase.bullets.map((bullet) => (
              <li class="flex items-start gap-3">
                <span class="mt-1 inline-block h-2 w-2 rounded-full bg-tv7-amber"></span>
                <span>{bullet}</span>
              </li>
            ))}
          </ul>
        </GlowPanel>
      ))}
    </div>
  </SectionWrapper>

  <SectionWrapper id="faq" spacing="tight">
    <SectionHeader eyebrow="FAQ" title="Quick answers" description="Everything you need to know before you clip." />
    <div class="grid gap-4 md:grid-cols-2">
      {miniFaq.map((item, idx) => (
        <FAQItem question={item.question} answer={item.answer} open={idx === 0} />
      ))}
    </div>
    <div class="mt-6">
      <a href="/faq" class="inline-flex items-center gap-2 text-tv7-cyan hover:text-tv7-cyanSoft transition font-semibold">
        View all FAQs →
      </a>
    </div>
  </SectionWrapper>

  <SectionWrapper spacing="tight">
    <SectionHeader
      eyebrow="CTA"
      title="Ready to repurpose faster?"
      description="Follow the development status before a public desktop release."
      align="center"
    />
    <GlowPanel class="relative overflow-hidden rounded-2xl border-2 border-tv7-borderStrong bg-gradient-to-r from-tv7-surface/80 via-tv7-bgSecondary/80 to-tv7-surface/80 px-6 py-10 shadow-xl">
      <div class="absolute inset-0 bg-[radial-gradient(circle_at_30%_20%,rgba(245,158,11,0.08),transparent_40%)] opacity-60"></div>
      <div class="relative flex flex-col items-center gap-4 text-center">
        <a
          href="/downloads"
          class="btn-primary px-6 py-3"
        >
          View Development Status
        </a>
      </div>
    </GlowPanel>
  </SectionWrapper>
</BaseLayout>
