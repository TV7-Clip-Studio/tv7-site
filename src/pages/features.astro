---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FeatureCard from '../components/FeatureCard.astro';
import GlowPanel from '../components/GlowPanel.astro';

const current = [
  { title: 'Local import and render', description: 'Import a creator-supplied video and render a selected range with the local Rust Engine.' },
  { title: 'Transcript-based review', description: 'Import WebVTT captions, inspect timing candidates, and adjust the selected range.' },
  { title: 'Channel preselection', description: 'Discover videos from a channel and select them before confirming a download attempt.' },
  { title: 'Optional cloud handoff', description: 'Explicitly upload a finished clip to private storage and create a schedule draft.' },
];
const planned = [
  { title: 'Reliable creator import', description: 'Rights-compliant imports and dependable bulk workflows for creator-owned libraries.' },
  { title: 'Automatic transcription and ranking', description: 'Local transcription and useful clip suggestions that creators can review.' },
  { title: 'Full editing and packaging', description: 'Durable project editing, bundled media tools, signed macOS builds, and Windows validation.' },
  { title: 'Scheduled publishing', description: 'Verified account connections and publishing to YouTube, Instagram, and TikTok.' },
];
---

<BaseLayout title="Features — TV7" description="Current TV7 development proof and planned creator features.">
  <SectionWrapper>
    <SectionHeader eyebrow="Current proof" title="What works today" description="These capabilities have been exercised in the internal development build." />
    <div class="grid gap-4 sm:grid-cols-2">{current.map((item) => <FeatureCard title={item.title} description={item.description} />)}</div>
  </SectionWrapper>
  <SectionWrapper>
    <SectionHeader eyebrow="Roadmap" title="What we are building next" description="These are product goals, not released features." />
    <div class="grid gap-4 sm:grid-cols-2">{planned.map((item) => <FeatureCard title={item.title} description={item.description} />)}</div>
    <GlowPanel class="mt-8 p-6"><a href="/downloads" class="font-semibold text-tv7-cyan hover:text-tv7-cyanSoft">See release status →</a></GlowPanel>
  </SectionWrapper>
</BaseLayout>
