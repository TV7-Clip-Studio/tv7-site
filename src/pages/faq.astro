---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import FAQItem from '../components/FAQItem.astro';

const faqs = [
  { question: 'Can I download TV7 now?', answer: 'There is no public installer yet. A macOS internal development package has been tested. Windows validation is still ahead.' },
  { question: 'Where does video processing happen?', answer: 'The current proof imports and renders media in a local Engine. Finished clips reach private cloud storage only after an explicit handoff.' },
  { question: 'Can I import a YouTube channel?', answer: 'The proof can discover a channel and let you preselect videos. Actual YouTube downloads are not reliable yet and release depends on applicable platform permissions and creator rights.' },
  { question: 'Does TV7 automatically transcribe and find viral clips?', answer: 'Not yet. The proof accepts a WebVTT transcript and suggests bounded timing ranges. Automatic transcription and quality ranking are planned.' },
  { question: 'Can I schedule and publish to social networks?', answer: 'You can create a schedule draft after choosing to upload a finished clip. Live publishing to YouTube, Instagram, and TikTok is still being implemented and verified.' },
  { question: 'Is there a subscription?', answer: 'No public plans or checkout exist yet. Cloud storage and scheduling fees are being designed.' },
];
---

<BaseLayout title="FAQ — TV7" description="Current answers about the TV7 development proof and roadmap.">
  <SectionWrapper>
    <SectionHeader eyebrow="FAQ" title="Frequently asked questions" description="What works in the current proof and what remains in development." align="center" />
    <div class="grid gap-4">
      {faqs.map((item) => <FAQItem question={item.question} answer={item.answer} />)}
    </div>
  </SectionWrapper>
</BaseLayout>
