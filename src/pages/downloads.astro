---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlowPanel from '../components/GlowPanel.astro';
---

<BaseLayout title="Development status — TV7" description="TV7 desktop is in development. There is no public installer yet.">
  <SectionWrapper>
    <SectionHeader eyebrow="Development status" title="Desktop release in progress" description="There is no public TV7 download yet. The current macOS package is an internal development proof, not a supported creator release." />
    <div class="grid gap-6 md:grid-cols-2">
      <GlowPanel class="p-6">
        <h3 class="mb-3 text-xl font-display font-semibold text-tv7-text-primary">Working in the proof</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-tv7-text-secondary">
          <li>One Studio interface for browser testing and a macOS Tauri package.</li>
          <li>Local video import, WebVTT import, clip timing review, and local captioned MP4 render.</li>
          <li>Optional private upload of a finished clip and a schedule draft.</li>
        </ul>
      </GlowPanel>
      <GlowPanel class="p-6">
        <h3 class="mb-3 text-xl font-display font-semibold text-tv7-text-primary">Before public release</h3>
        <ul class="list-disc pl-5 space-y-2 text-sm text-tv7-text-secondary">
          <li>Package and sign the media dependencies; validate Windows.</li>
          <li>Make transcription, editing, and import reliable for real creator libraries.</li>
          <li>Verify platform account connections and actual scheduled publishing.</li>
          <li>Finish licensing, storage billing, and support.</li>
        </ul>
      </GlowPanel>
    </div>
  </SectionWrapper>
</BaseLayout>
