---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlowPanel from '../components/GlowPanel.astro';
---

<BaseLayout title="Docs — TV7" description="Current documentation for the TV7 development proof.">
  <SectionWrapper>
    <SectionHeader eyebrow="Docs" title="Development proof guide" description="TV7 is not available as a supported public download yet. This describes the current internal workflow." align="center" />
    <div class="grid gap-6 md:grid-cols-2">
      <GlowPanel class="p-6">
        <h3 class="mb-3 text-lg font-display font-semibold text-tv7-text-primary">Local clip</h3>
        <ol class="list-decimal pl-5 space-y-2 text-sm text-tv7-text-secondary">
          <li>Import a creator-supplied video file.</li>
          <li>Import a WebVTT caption file for that video.</li>
          <li>Select and adjust a timing candidate.</li>
          <li>Render a captioned MP4 locally.</li>
        </ol>
      </GlowPanel>
      <GlowPanel class="p-6">
        <h3 class="mb-3 text-lg font-display font-semibold text-tv7-text-primary">Optional cloud draft</h3>
        <p class="text-sm text-tv7-text-secondary">After reviewing the rendered clip, explicitly choose to upload it to private Backend storage and create a schedule draft. A draft does not publish to any social network.</p>
      </GlowPanel>
    </div>
    <p class="mt-6 text-sm text-tv7-text-tertiary">Automatic transcription, full editing controls, public installers, and live publishing are still being developed.</p>
  </SectionWrapper>
</BaseLayout>
