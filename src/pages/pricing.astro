---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlowPanel from '../components/GlowPanel.astro';
---

<BaseLayout title="Pricing — TV7" description="TV7 pricing is not available while the desktop product is in development.">
  <SectionWrapper>
    <SectionHeader eyebrow="Pricing" title="Pricing is not set" description="TV7 has no public plans or checkout yet. We are validating the local creator workflow and cloud scheduling before setting prices." align="center" />
    <GlowPanel class="p-8">
      <p class="text-tv7-text-secondary">The intended model keeps CPU-heavy media work on your computer. Cloud storage and scheduled publishing may carry a small fee once those services are released.</p>
      <a href="/downloads" class="mt-5 inline-flex text-tv7-cyan hover:text-tv7-cyanSoft font-semibold">See development status →</a>
    </GlowPanel>
  </SectionWrapper>
</BaseLayout>
