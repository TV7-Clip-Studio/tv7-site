---
import BaseLayout from '../layouts/BaseLayout.astro';
import SectionWrapper from '../components/SectionWrapper.astro';
import SectionHeader from '../components/SectionHeader.astro';
import GlowPanel from '../components/GlowPanel.astro';

const steps = [
  { title: 'Bring a local video', description: 'Import a creator-supplied recording. Channel discovery and preselection are present, but YouTube downloads are not reliable enough for release.' },
  { title: 'Import captions and review timing', description: 'Add a WebVTT transcript, select a timing candidate, and edit the clip boundaries. Automatic transcription and viral ranking remain planned.' },
  { title: 'Render on your computer', description: 'The local Rust Engine renders a captioned MP4. Heavy media processing does not run in the cloud Backend.' },
  { title: 'Choose a cloud handoff', description: 'Optionally upload the finished clip to private storage and create a schedule draft. Drafts do not publish a post.' },
];
---

<BaseLayout title="How it works — TV7" description="How the current TV7 development proof handles local video and optional cloud drafts.">
  <SectionWrapper>
    <SectionHeader eyebrow="Current workflow" title="From local file to schedule draft" description="The current proof reaches a draft. Live social publishing is still in development." align="center" />
    <div class="grid gap-6 md:grid-cols-2">
      {steps.map((step, idx) => (
        <GlowPanel class="p-6">
          <p class="mb-3 text-xs font-semibold uppercase tracking-widest text-tv7-cyan">Step {idx + 1}</p>
          <h3 class="mb-2 text-xl font-display font-semibold text-tv7-text-primary">{step.title}</h3>
          <p class="text-sm text-tv7-text-secondary">{step.description}</p>
        </GlowPanel>
      ))}
    </div>
  </SectionWrapper>
</BaseLayout>
